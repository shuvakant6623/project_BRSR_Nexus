# --- Database ---
POSTGRES_USER=brsr
POSTGRES_PASSWORD=brsr
POSTGRES_DB=brsr
DATABASE_URL=postgresql+psycopg://brsr:brsr@postgres:5432/brsr

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Object storage (MinIO / S3-compatible) ---
MINIO_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=brsr
S3_SECRET_KEY=brsr-secret
S3_BUCKET=brsr-evidence
# Public browser-reachable endpoint for presigned downloads (blank = same as S3_ENDPOINT)
S3_PUBLIC_ENDPOINT=http://localhost:9000

# --- Auth ---
JWT_SECRET=dev-only-secret-change-me-in-production-32b
JWT_ACCESS_EXPIRY_MINUTES=60
JWT_REFRESH_EXPIRY_DAYS=7

# --- Evidence uploads ---
MAX_EVIDENCE_FILE_SIZE_MB=25
ALLOWED_EVIDENCE_MIME_TYPES=application/pdf,text/csv,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,image/png,image/jpeg

# --- Validation ---
DEFAULT_YOY_VARIANCE_THRESHOLD_PERCENT=20

# --- Reminders ---
REMINDER_DAYS_BEFORE_DUE=7
ESCALATION_DAYS_AFTER_OVERDUE=3

# --- AI/OCR (none = local demo provider, if implemented) ---
AI_PROVIDER=none
AI_API_KEY=
OCR_PROVIDER=none

# --- Frontend ---
FRONTEND_API_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000
